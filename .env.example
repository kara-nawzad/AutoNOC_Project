# AutoNOC environment variables (roadmap item — was missing).
# Copy to .env or export in your shell. The API reads these at boot.

# Simulation seed (the "Storm over Goizha" demo uses 131)
AUTONOC_SEED=42

# 1 = auto-enable the Commander at boot
AUTONOC_AI=0

# Auto-approve Commander actions after N wall-clock seconds (demo mode; 0 = off)
AUTONOC_AUTO_APPROVE=0
