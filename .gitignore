# Python bytecode and native build products
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.python-version

# Environments and local secrets
.env
.env.*
!.env.example
.envrc
venv/
.venv/
env/
ENV/

# Test, coverage, and Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
coverage/
htmlcov/
.tox/
.nox/

# Node, Vite, and package-manager output
**/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.npm/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Generated frontend bundle (built by Vite/Docker; never source)
/autonoc/web/dist/

# Browser-test output
/frontend/test-results/
/frontend/playwright-report/

# IDE and operating-system files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime logs and local process output
*.log
*.err

# Regenerable datasets / local application data.
# Trained artifacts under models/ (including the required .npz scalers) are
# intentionally committed for reproducible local and Fly.io startup.
/data/
